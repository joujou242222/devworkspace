{
  "name": "devworkspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": "24.14.0",
    "pnpm": "10.18.1"
  },
  "scripts": {
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:env": "node scripts/check-env.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r --sort typecheck",
    "db:generate": "pnpm --filter @devworkspace/database generate",
    "db:seed:demo": "node scripts/seed-production-demo.mjs",
    "start:prod": "node scripts/prod-start.mjs",
    "build": "pnpm db:generate && pnpm -r --sort build",
    "test": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "test:e2e": "playwright test phase2.spec.ts",
    "check": "pnpm check:runtime && pnpm check:boundaries && pnpm check:docs && pnpm check:infra && pnpm openapi:check && pnpm check:env && pnpm lint && pnpm typecheck && pnpm test && pnpm format:check",
    "setup:local": "node scripts/setup-local.mjs",
    "experiment:prepare": "node scripts/prepare-experiment.mjs",
    "dev": "node scripts/dev.mjs",
    "infra:config": "docker compose --env-file .env.local -f infra/compose.yaml config --quiet",
    "infra:up": "docker compose --env-file .env.local -f infra/compose.yaml up --build -d",
    "infra:down": "docker compose --env-file .env.local -f infra/compose.yaml down",
    "openapi:generate": "node --env-file-if-exists=.env.local scripts/openapi.mjs",
    "openapi:check": "node --env-file-if-exists=.env.local scripts/openapi.mjs --check",
    "experiment:stop": "node scripts/stop-experiment.mjs",
    "check:infra": "node scripts/check-infra.mjs",
    "dev:stop": "node scripts/stop-local.mjs",
    "native:setup": "node scripts/setup-native.mjs",
    "native:up": "node scripts/native-infra.mjs up",
    "native:status": "node scripts/native-infra.mjs status",
    "native:down": "node scripts/native-infra.mjs down",
    "native:restart": "node scripts/native-infra.mjs restart",
    "test:native": "node --test --test-concurrency=1 tests/native/*.test.mjs",
    "phase2:prepare": "node scripts/prepare-phase2.mjs",
    "test:phase2": "node --test --test-concurrency=1 tests/phase2/*.test.mjs",
    "phase2:mail-status": "node --env-file=.local/phase2-worker.env scripts/phase2-mail-status.mjs",
    "test:e2e:experiment": "playwright test foundation.spec.ts",
    "dev:experiment": "node scripts/dev.mjs --experiment",
    "phase2:mail-retry": "node --env-file=.local/phase2-worker.env scripts/phase2-mail-retry.mjs",
    "test:phase3": "node --test --test-concurrency=1 tests/phase3/*.test.mjs",
    "test:e2e:phase3": "playwright test phase3.spec.ts",
    "phase4:storage-prepare": "node scripts/prepare-phase4-storage.mjs",
    "phase4:storage-provision": "node scripts/provision-phase4-storage.mjs",
    "phase4:processing-prepare": "node scripts/prepare-processing.mjs",
    "test:phase4": "node --test --test-timeout=300000 --test-concurrency=1 tests/phase4/*.test.mjs",
    "test:phase4:sandbox": "node --test --test-timeout=300000 tests/phase4/sandbox.test.mjs",
    "test:e2e:phase4": "playwright test phase4.spec.ts",
    "test:phase5": "node --test --test-timeout=600000 --test-concurrency=1 tests/phase5/*.test.mjs",
    "test:e2e:phase5": "playwright test phase5.spec.ts",
    "test:phase6": "node --test --test-timeout=300000 --test-concurrency=1 tests/phase6/*.test.mjs",
    "test:e2e:phase6": "playwright test phase6.spec.ts",
    "events:status": "node --env-file=.local/phase2-worker.env scripts/event-delivery-status.mjs",
    "events:retry": "node --env-file=.local/phase2-worker.env scripts/phase2-mail-retry.mjs",
    "test:phase7": "node --test --test-timeout=300000 --test-concurrency=1 tests/phase7/*.test.mjs",
    "test:e2e:phase7": "playwright test phase7.spec.ts",
    "test:phase8": "node --test --test-timeout=300000 --test-concurrency=1 tests/phase8/*.test.mjs",
    "test:e2e:phase8": "playwright test phase8.spec.ts",
    "phase9:reconcile": "node scripts/phase9-reconcile.mjs",
    "phase9:db-recovery": "node scripts/phase9-db-recovery.mjs",
    "phase9:snapshot": "node scripts/phase9-recovery.mjs snapshot",
    "phase9:restore": "node scripts/phase9-recovery.mjs restore",
    "phase9:workload": "node scripts/phase9-workload.mjs",
    "test:e2e:phase9": "playwright test phase9.spec.ts"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.22",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "10.12.0",
    "http-proxy": "1.18.1",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "yaml": "2.8.1"
  }
}
