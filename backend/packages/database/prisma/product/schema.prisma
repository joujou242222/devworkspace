generator client {
  provider = "prisma-client"
  output = "../../src/generated-product"
  moduleFormat = "esm"
}
datasource db {
  provider = "postgresql"
}
model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  active Boolean @default(true)
  revision Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  sessions Session[]
  accounts Account[]
  @@map("identity_user")
}
model Session {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  token String @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  lastActivityAt DateTime @default(now()) @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  @@index([userId])
  @@map("identity_session")
}
model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope String?
  password String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([userId, providerId])
  @@map("identity_account")
}
model Verification {
  id String @id
  identifier String @unique
  value String
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@map("identity_verification")
}
model EmailProof {
  id String @id
  userId String
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  @@map("identity_email_proof")
}
model IdentityMail {
  id String @id
  userId String
  kind String
  envelope String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@map("identity_mail")
}
model Organization {
  id String @id @db.Uuid
  name String
  description String @default("")
  timezone String @default("UTC")
  status String @default("ACTIVE")
  revision Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  memberships Membership[]
  @@map("organization")
}
model Membership {
  id String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id])
  userId String @map("user_id")
  role String
  status String @default("ACTIVE")
  revision Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([organizationId, id])
  @@unique([organizationId, userId])
  @@map("membership")
}

// Phase 3 scalar mappings; reviewed SQL owns composite FKs, triggers and RLS.
