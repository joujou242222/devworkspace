# Copy using pnpm setup:local: actual secrets/certificates are generated under ignored paths.
NODE_ENV=development
APP_ORIGIN=https://localhost:8443
BIND_HOST=127.0.0.1
API_PORT=3001
WEB_PORT=3000
API_INTERNAL_URL=http://127.0.0.1:3001
WEB_INTERNAL_URL=http://127.0.0.1:3000
S3_INTERNAL_URL=http://127.0.0.1:9000
EXPERIMENT_AUTH_ENABLED=false
# Experiment requires a disposable PostgreSQL URL and random >=32-character secret.
# DATABASE_URL=
# BETTER_AUTH_SECRET=
